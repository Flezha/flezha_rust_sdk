{
  "runtime": "rust",
  "sdk_lang": 1,
  "command": {
    "test": "cargo run --quiet --manifest-path={artifact} --target-dir=./target -- {namespace}",
    "bench": "{artifact} {namespace}"
  },
  "artifacts": {
    "test": [
      "Cargo.toml"
    ],
    "bench": [
      "../../../target/release/rust_runner",
      "target/release/rust_runner",
      "../../../target/debug/rust_runner",
      "target/debug/rust_runner"
    ]
  },
  "build": {
    "test": "cargo build --manifest-path=sdk/rust/test_app/Cargo.toml --target-dir=./target",
    "bench": "cargo build -p rust_runner --release"
  },
  "connect_timeout_ms": 120000,
  "transports": [
    "uds",
    "quic"
  ],
  "dispatch": {
    "model": "thread-pool",
    "detail": "A worker pool of OS threads; per-cell exclusivity keeps one Cell on one worker at a time.",
    "env": {
      "FLEZHA_WORKER_POOL_SIZE": "worker threads (default: the host's core count)"
    }
  },
  "topology_surfaces": [
    "merge",
    "branch",
    "workflow",
    "shorthand",
    "shorthand_typed_output"
  ],
  "toolchain": "rustc --version",
  "deferred": [],
  "fixtures": {
    "runner_lifecycle": [
      "do_nothing",
      "compare_filter",
      "bench_echo"
    ],
    "connect_discovery": [
      "do_nothing"
    ],
    "graph_builder": [
      "sugar_static_cell",
      "static_cell",
      "mixed_operative",
      "hybrid_channel",
      "merged_input",
      "transform_chain",
      "cell_stress",
      "bench_keyed_nopersist"
    ],
    "shorthand": [
      "sugar_do_nothing",
      "sugar_store_input",
      "sugar_named_input",
      "sugar_workflow",
      "sugar_workflow_per_input",
      "sugar_state_only"
    ],
    "liveness": [
      "wedge_probe"
    ],
    "retry_ladder": [
      "poison_probe",
      "bounded_mailbox_drop_nothing",
      "bounded_mailbox_drop_newest",
      "bounded_mailbox_drop_oldest"
    ],
    "state_persistence": [
      "store_input",
      "stateful_counter",
      "coalescing_counter",
      "persistence_off_counter",
      "resume_probe",
      "bench_keyed"
    ],
    "effectively_once": [
      "tier_store",
      "checkpoint_store",
      "checkpoint_batched_store",
      "bench_checkpoint"
    ],
    "cell_timers": [
      "session_timeout"
    ],
    "correction_window": [
      "candle"
    ],
    "keyed_channels": [
      "partition_relay"
    ],
    "workflow": [
      "spawn_requester",
      "spawn_once_requester",
      "echo_workflow",
      "workflow_timer_refused",
      "typed_once_workflow",
      "commit_block_workflow",
      "sync_durable_workflow",
      "optout_commit_block",
      "tier_commit_block_workflow",
      "saga_block_workflow",
      "outbox_block_workflow",
      "undo_outbox_workflow",
      "chat_loop_workflow",
      "stateless_loop_workflow",
      "chat_rewind_workflow",
      "reply_block_loop_workflow",
      "retry_workflow",
      "branch_workflow",
      "diamond_workflow",
      "bench_chain_1",
      "bench_chain_4",
      "bench_chain_16",
      "bench_chain_optout_4",
      "bench_loop_workflow"
    ],
    "dynamic_cell": [
      "dynamic_cell"
    ],
    "partitioned": [
      "partition_relay",
      "dynamic_cell"
    ],
    "pool_wedge": [
      "wedge_probe"
